{
  "name": "@owox/idp-one-os",
  "version": "0.44.0",
  "type": "module",
  "author": "OWOX",
  "license": "ELv2",
  "description": "One OS (Supabase) identity bridge for OWOX IDP Protocol — Oweb satellite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWOX/owox-data-marts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsc",
    "build:dep": "npm run build:idp-protocol",
    "build:idp-protocol": "npm run build -w @owox/idp-protocol --prefix ../..",
    "clean": "shx rm -rf dist",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "lint": "eslint . --config ./eslint.config.js",
    "lint:fix": "eslint . --fix --config ./eslint.config.js",
    "format": "prettier --write \"**/*.{ts,js,json,md}\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\" --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck"
  },
  "keywords": ["idp", "supabase", "one-os", "authentication", "owox"],
  "peerDependencies": {
    "express": "^5",
    "zod": "^4.6.6"
  },
  "dependencies": {
    "@owox/idp-protocol": "*",
    "@owox/internal-helpers": "*",
    "jose": "^6.0.12",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@owox/eslint-config": "*",
    "@owox/prettier-config": "*",
    "@owox/typescript-config": "*",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}