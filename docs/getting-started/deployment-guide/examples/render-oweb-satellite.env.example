# Oweb satellite on Render — environment template
# Copy into Render Environment (Secret type for passwords).
# See render-oweb-satellite.md for setup steps.

PUBLIC_ORIGIN=https://owox-your-org.onrender.com
LOG_FORMAT=json

# Application database (external MySQL — not Render Postgres)
DB_TYPE=mysql
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USERNAME=owox_app
DB_PASSWORD=change-me
DB_DATABASE=owox
DB_MYSQL_SSL=true

# Interim identity (until One OS / Supabase IdP ships)
IDP_PROVIDER=better-auth
IDP_BETTER_AUTH_SECRET=change-me-run-openssl-rand-base64-32
IDP_BETTER_AUTH_DATABASE_TYPE=mysql

SCHEDULER_EXECUTION_ENABLED=true

# Optional: full Report Runs on self-managed
# LICENSE_KEY=

# Optional: DuckDB on persistent disk (single instance only)
# DUCKDB_STORAGE_ENABLED=false
# DUCKDB_DATA_DIR=/root/.local/share/owox/duckdb

# --- One OS via OWeb control plane (oMetrics) — replace Better Auth block -------
# IDP_PROVIDER=one-os
# IDP_ONE_OS_SUPABASE_URL=https://auth.oweb.one
# IDP_ONE_OS_SIGN_IN_URL=https://oweb.one/login
# IDP_ONE_OS_ECOSYSTEM_APP_ID=ometrics
# IDP_ONE_OS_OWEB_CONTROL_PLANE_URL=https://oweb.one
# IDP_ONE_OS_SESSION_SECRET=change-me-min-32-chars-openssl-rand-base64-32
# IDP_ONE_OS_WORKSPACE_PROJECT_MAP={"your-workspace-uuid":"0"}
# IDP_ONE_OS_ACTIVATION_SECRET=change-me-min-32-chars-for-one-os-backend
# IDP_ONE_OS_BINDINGS_FILE=/root/.local/share/owox/one-os-workspace-bindings.json
# SQLITE_DB_PATH=/root/.local/share/owox/sqlite/backend.db